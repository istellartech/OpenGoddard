---
// Pre-rendered Matplotlib videos for one example (see scripts/build_media.py).
import { Aside } from '@astrojs/starlight/components';
import { mediaManifest, mediaUrl } from '../lib/catalog';

interface Props {
  id: string;
  /** Show the static figures drawn by the example's plot(). */
  figures?: boolean;
}

const { id, figures = true } = Astro.props;
const manifest = mediaManifest(id);
const videos = manifest?.videos ?? [];
const failed = Object.entries(manifest?.solver ?? {}).filter(([, status]) => !status.success);
const guide = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/getting-started/#動画の見方`;
---

{
  !manifest && (
    <Aside type="caution" title="動画未生成">
      リポジトリのルートで <code>uv run python website/scripts/build_media.py {id}</code>{' '}
      を実行すると生成される。
    </Aside>
  )
}
{
  failed.map(([name, status]) =>
    status.message.includes('Iteration limit') ? (
      <Aside type="caution" title="反復回数の上限で停止">
        <code>{name}</code>: <code>{status.message}</code>。収束判定を満たした解ではない。
      </Aside>
    ) : (
      <Aside type="danger" title="未収束">
        <code>{name}</code>: <code>{status.message}</code>。動画は失敗時点の値を示す。
      </Aside>
    ),
  )
}
{
  videos.length === 1 && (
    <figure class="example-video">
      <video controls preload="metadata" playsinline poster={mediaUrl(id, videos[0].poster)}>
        <source src={mediaUrl(id, videos[0].video)} type="video/mp4" />
      </video>
      <figcaption>
        <a href={guide}>動画の見方</a> ・ <a href={mediaUrl(id, 'solution.json')}>数値データ（JSON）</a>
      </figcaption>
    </figure>
  )
}
{
  figures && manifest && manifest.figures.length > 0 && (
    <details class="example-figures">
      <summary>例題が保存する図（{manifest.figures.length}枚）</summary>
      <div class="figure-grid">
        {manifest.figures.map((figure) => (
          <a href={mediaUrl(id, figure)}>
            <img src={mediaUrl(id, figure)} alt={figure} loading="lazy" />
          </a>
        ))}
      </div>
    </details>
  )
}
